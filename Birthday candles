function blowCandles(str) {
  // Let's see how we gonna blow these candles...
  // get the number find a value that is not 0
  // find the next 3 values and subtract 1
  // it's a string
  for (let i = 0; i < str.length(); i+0){
    // check if number
    // if not a number do nothing
    // if a match is found
    // while i is not 0 keep subtracting
    //
    while(i != 0){
      str.charAt(i) - 1 // subtract the first one
      //check if the following 2 are >0 then sub
      // char 2
      if str.charAt(i+1) > 0
        str.charAt(i+1) - 1
      // char 3
      if str.charAt(i+2) > 0
        str.charAt(i+2) - 1
    }
  }
}
