function solve(compasses, gears, tablets) { 
  let sum = 0;
  let distinctSet = 0;
  let A = compasses, B = gears, C = tablets;
  do{
    distinctSet++;
    A--;
    B--;
    C--;
  }while(A >= 1 && B >= 1 && C >= 1)
  sum = (distinctSet * 7) + Math.pow(compasses,2) + Math.pow(gears,2) + Math.pow(tablets,2);
  
  return sum;
}
